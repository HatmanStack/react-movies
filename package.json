{
  "name": "react-movies",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || true"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.3.13",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-modules-core": "~57.0.7",
    "expo-image": "^57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-sqlite": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.86.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "^4.5.2",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "~0.10.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.9.1",
    "eslint-config-expo": "^57.0.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.8",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native": {
      "react": "$react"
    },
    "@jest/globals": "^30.0.0",
    "babel-jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-environment-node": "^30.0.0",
    "jest-mock": "^30.0.0",
    "jest-snapshot": "^30.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
